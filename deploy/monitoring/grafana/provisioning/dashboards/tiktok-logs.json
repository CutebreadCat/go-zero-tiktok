{
  "uid": "tiktok-logs",
  "title": "TikTok 业务日志总览",
  "tags": ["tiktok", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "各服务日志量 / 分钟",
      "description": "按 service 标签统计每分钟日志行数(指标查询,返回数值)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": { "mode": "normal" },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (service) (count_over_time({service=~\".+\"}[1m]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "日志级别分布",
      "description": "当前时间范围内的日志量按 level 标签占比",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single" },
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({service=~\".+\"}[$__range]))",
          "legendFormat": "{{level}}",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ERROR 日志数",
      "description": "当前时间范围内 level=ERROR 的日志行数",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({level=\"ERROR\"}[$__range])) or vector(0)",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "实时日志流",
      "description": "原始日志,点击任意一行可展开 trace_id / span_id 等结构化字段",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 8 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=~\".+\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
