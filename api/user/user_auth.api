syntax = "v1"

import "./user.api"

@server(
  group: user
  jwt: Auth
  tags:"user"
)
service tiktok-api {
  @handler PostUserPhotoHandler
  put /user/avatar/upload (UserphotoRequest) returns (UserphotoResponse)
   @handler GetMfaqrcodeHandler
  get /user/mfa/qrcode (MfaqrcodeRequest) returns (MfaqrcodeResponse)
  @handler BindMfaHandler
  post /user/mfa/bind (BindMfaqrcodeRequest) returns (BindMfaqrcodeResponse)
  @handler JwchLoginHandler
  post /user/jwch/login (JwchLoginRequest) returns (JwchLoginResponse)
}
