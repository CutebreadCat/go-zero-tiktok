syntax = "v1"

import "../model.api"

// 账户模块：注册、登录、刷新令牌
// 鉴权由网关全局 token.AuthMiddleware + publicPaths 白名单统一管控
@server(
  group: user
  middleware: RateLimit
  tags:"user"
)
service tiktok-api {
  // 注册
  @handler RegisterHandler
  post /users (RegisterRequest) returns (RegisterResponse)

  // 登录
  @handler LoginHandler
  post /sessions (LoginRequest) returns (LoginResponse)

  // 刷新令牌
  @handler RefreshTokenHandler
  post /sessions/refresh (RefreshTokenRequest) returns (RefreshTokenResponse)
}

type (
  RegisterRequest {
    Username string `form:"username"`
    Password string `form:"password"`
  }
  RegisterResponse {
    Base   BaseResponse `json:"base"`
    UserID int64        `json:"user_id,string"`
  }

  LoginRequest {
    Username string `form:"username"`
    Password string `form:"password"`
    MfaCode  string `form:"mfa_code"`
  }
  LoginResponse {
    Base         BaseResponse `json:"base"`
    UserID       int64        `json:"user_id,string"`
    AccessToken  string       `json:"-"`
    RefreshToken string       `json:"-"`
  }

  RefreshTokenRequest {
    RefreshToken string `json:"-"`
  }
  RefreshTokenResponse {
    Base         BaseResponse `json:"base"`
    AccessToken  string       `json:"-"`
    RefreshToken string       `json:"-"`
  }

  GetUserInfoRequest {
  }
  GetUserInfoResponse {
    Base BaseResponse `json:"base"`
    User UserBaseinfo `json:"user"`
  }

  // 文件字段(可选):支持两种传法——
  // 1. multipart/form-data 真文件上传(handler 用 r.FormFile("file") 读取,优先);
  // 2. base64 文本(httpx 解析到本字段后 handler 再 base64 解码,兜底)。
  // 注意:不要声明为 []byte,go-zero 对 []byte+form 只做 base64 解码,非 base64 会报 type mismatch。
  UpdateUserPhotoRequest {
    File string `form:"file,optional"`
  }
  UpdateUserPhotoResponse {
    Base     BaseResponse `json:"base"`
    PhotoURL string       `json:"photo_url"`
  }

  GetMfaQRCodeRequest {
  }
  GetMfaQRCodeResponse {
    Base      BaseResponse `json:"base"`
    QRCodeURL string       `json:"qr_code_url"`
    MfaSecret string       `json:"mfa_secret"`
  }

  BindMfaRequest {
    MfaSecret string `form:"mfa_secret"`
    MfaCode   string `form:"mfa_code"`
  }
  BindMfaResponse {
    Base BaseResponse `json:"base"`
  }
)