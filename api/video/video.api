syntax = "v1"

import "../model.api"

// 视频模块（公开读取）：详情、作者视频、搜索、热门、Feed
// feeed 与热门、搜索为公开口；发布走 ./video_auth.api
@server(
  group: video
  middleware: RateLimit
  tags:"video"
)
service tiktok-api {
  // 作者视频列表
  @handler GetVideoListHandler
  get /users/:id/videos (GetVideoListRequest) returns (GetVideoListResponse)

  // 搜索视频
  @handler VideoSearchHandler
  get /videos/search (VideoSearchRequest) returns (VideoSearchResponse)

  // 热门视频
  @handler VideoPopularHandler
  get /videos/popular (VideoPopularRequest) returns (VideoPopularResponse)

  // Feed 视频流
  @handler GetFeedVideoHandler
  get /feed-items (FeedVideoRequest) returns (FeedVideoResponse)
}

type (
  GetVideoListRequest {
    UserId   int64 `path:"id"`
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  GetVideoListResponse {
    Base   BaseResponse    `json:"base"`
    Videos []VideoBaseinfo `json:"videos"`
    Total  int64           `json:"total"`
  }

  VideoSearchRequest {
    Keyword  string `form:"keyword"`
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  VideoSearchResponse {
    Base   BaseResponse    `json:"base"`
    Videos []VideoBaseinfo `json:"videos"`
  }

  VideoPopularRequest {
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  VideoPopularResponse {
    Base  BaseResponse `json:"base"`
    Items []Item       `json:"items"`
  }

  FeedVideoRequest {
    LastTime string `form:"last_time,optional"`
    PageNum  int32  `form:"page_num,optional"`
    PageSize int32  `form:"page_size,optional"`
    Scene    string `form:"scene,optional"`
    Cursor   string `form:"cursor,optional"`
    Limit    int32  `form:"limit,optional"`
  }
  FeedVideoResponse {
    Base       BaseResponse `json:"base"`
    Total      int64        `json:"total"`
    NextCursor string       `json:"next_cursor"`
    HasMore    bool         `json:"has_more"`
    Items      []Item       `json:"items"`
  }

  Item {
    Videos        VideoBaseinfo `json:"videos"`
    VideosPopular VideoPopular  `json:"videos_popular"`
    Author        UserBaseinfo  `json:"author"`
    Liked         bool          `json:"liked"`
    Favorited     bool          `json:"favorited"`
  }
)