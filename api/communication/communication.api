syntax = "v1"

import "../model.api"

// 关系模块：关注、粉丝、好友
// 鉴权由网关全局 token.AuthMiddleware + publicPaths 白名单统一管控
@server(
  group: communication
  middleware: RateLimit
  tags:"communication"
)
service tiktok-api {
  // 关注用户
  @handler SubscribeHandler
  put /users/me/following/:id (SubscribeRequest) returns (SubscribeResponse)

  // 取关用户
  @handler UnsubscribeHandler
  delete /users/me/following/:id (UnsubscribeRequest) returns (UnsubscribeResponse)

  // 我的关注列表
  @handler GetSubscriberListHandler
  get /users/me/following (GetSubscriberListRequest) returns (GetSubscriberListResponse)

  // 我的粉丝列表
  @handler GetFansListHandler
  get /users/me/followers (GetFansListRequest) returns (GetFansListResponse)

  // 我的好友列表（互关）
  @handler GetFriendListHandler
  get /users/me/friends (GetFriendListRequest) returns (GetFriendListResponse)
}

type (
  SubscribeRequest {
    ToUserID int64 `path:"id"`
  }
  SubscribeResponse {
    Base BaseResponse `json:"base"`
  }

  UnsubscribeRequest {
    ToUserID int64 `path:"id"`
  }
  UnsubscribeResponse {
    Base BaseResponse `json:"base"`
  }

  GetSubscriberListRequest {
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  GetSubscriberListResponse {
    Base            BaseResponse   `json:"base"`
    SubscriberList  []UserBaseinfo `json:"subscriber_list"`
    SubscriberCount int64          `json:"subscriber_count"`
  }

  GetFansListRequest {
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  GetFansListResponse {
    Base      BaseResponse   `json:"base"`
    FansList  []UserBaseinfo `json:"fans_list"`
    FansCount int64          `json:"fans_count"`
  }

  GetFriendListRequest {
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  GetFriendListResponse {
    Base        BaseResponse   `json:"base"`
    FriendList  []UserBaseinfo `json:"friend_list"`
    FriendCount int64          `json:"friend_count"`
  }
)