syntax = "v1"

import "../model.api"

// 互动模块：点赞、评论、回复
// 鉴权由网关全局 token.AuthMiddleware + publicPaths 白名单统一管控，此处不再按文件标记 jwt
@server(
  group: interaction
  middleware: RateLimit
  tags:"interaction"
)
service tiktok-api {
  // 点赞视频
  @handler LikeVideoHandler
  put /videos/:id/like (LikeVideoRequest) returns (LikeVideoResponse)

  // 取消点赞视频
  @handler CancelLikeVideoHandler
  delete /videos/:id/like (CancelLikeVideoRequest) returns (CancelLikeVideoResponse)

  // 我点赞过的视频列表
  @handler GetLikeListHandler
  get /users/me/likes (GetLikeListRequest) returns (GetLikeListResponse)

  // 发表评论
  @handler CommentVideoHandler
  post /videos/:id/comments (CommentVideoRequest) returns (CommentVideoResponse)

  // 评论列表
  @handler GetCommentListHandler
  get /videos/:id/comments (GetCommentListRequest) returns (GetCommentListResponse)

  // 删除评论
  @handler DeleteCommentHandler
  delete /comments/:id (DeleteCommentRequest) returns (DeleteCommentResponse)

  // 点赞评论
  @handler LikeCommentHandler
  put /comments/:id/like (LikeCommentRequest) returns (LikeCommentResponse)

  // 取消点赞评论
  @handler CancelLikeCommentHandler
  delete /comments/:id/like (CancelLikeCommentRequest) returns (CancelLikeCommentResponse)

  // 回复评论
  @handler ReplyCommentHandler
  post /comments/:id/replies (ReplyCommentRequest) returns (ReplyCommentResponse)
}

type (
  LikeVideoRequest {
    VideoId int64 `path:"id"`
  }
  LikeVideoResponse {
    Base BaseResponse `json:"base"`
  }

  CancelLikeVideoRequest {
    VideoId int64 `path:"id"`
  }
  CancelLikeVideoResponse {
    Base BaseResponse `json:"base"`
  }

  GetLikeListRequest {
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  GetLikeListResponse {
    Base      BaseResponse   `json:"base"`
    VideoList []VideoBaseinfo `json:"video_list"`
    LikeCount int64          `json:"like_count"`
  }

  CommentVideoRequest {
    VideoId     int64  `path:"id"`
    CommentText string `form:"comment_text"`
  }
  CommentVideoResponse {
    Base      BaseResponse `json:"base"`
    CommentID int64        `json:"comment_id,string"`
  }

  GetCommentListRequest {
    VideoId  int64 `path:"id"`
    PageNum  int32 `form:"page_num"`
    PageSize int32 `form:"page_size"`
  }
  GetCommentListResponse {
    Base         BaseResponse     `json:"base"`
    CommentList  []CommentBaseinfo `json:"comment_list"`
    CommentCount int64            `json:"comment_count"`
  }

  DeleteCommentRequest {
    CommentId int64 `path:"id"`
  }
  DeleteCommentResponse {
    Base BaseResponse `json:"base"`
  }

  LikeCommentRequest {
    CommentId int64 `path:"id"`
  }
  LikeCommentResponse {
    Base BaseResponse `json:"base"`
  }

  CancelLikeCommentRequest {
    CommentId int64 `path:"id"`
  }
  CancelLikeCommentResponse {
    Base BaseResponse `json:"base"`
  }

  ReplyCommentRequest {
    CommentId   int64  `path:"id"`
    CommentText string `form:"comment_text"`
  }
  ReplyCommentResponse {
    Base      BaseResponse `json:"base"`
    CommentID int64        `json:"comment_id,string"`
  }
)